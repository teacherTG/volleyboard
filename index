                </div>

                <!-- 팀 이름 드롭다운 & 직접입력 -->
                <div class="name-wrapper w-full flex items-center justify-center relative mb-4 h-16 md:h-20">
                    <!-- 드롭다운 모드 -->
                    <div class="relative w-full flex justify-center items-center h-full">
                        <select id="select-A" onchange="handleNameSelect('A')" class="team-name-input text-theme-red text-5xl md:text-6xl font-black uppercase tracking-widest cursor-pointer appearance-none bg-transparent h-full">
                            <option value="1반" class="text-black text-2xl">1반</option>
                            <option value="2반" class="text-black text-2xl">2반</option>
                            <option value="3반" class="text-black text-2xl">3반</option>
                            <option value="4반" class="text-black text-2xl">4반</option>
                            <option value="5반" class="text-black text-2xl">5반</option>
                            <option value="6반" class="text-black text-2xl">6반</option>
                            <option value="7반" class="text-black text-2xl">7반</option>
                            <option value="8반" class="text-black text-2xl">8반</option>
                            <option value="9반" class="text-black text-2xl">9반</option>
                            <option value="10반" class="text-black text-2xl">10반</option>
                            <option value="11반" class="text-black text-2xl">11반</option>
                            <option value="12반" class="text-black text-2xl">12반</option>
                            <option value="custom" class="text-black text-2xl font-bold bg-yellow-200">직접입력 ✏️</option>
                        </select>
                        <i id="icon-select-A" class="fas fa-chevron-down absolute right-4 text-2xl text-gray-400 pointer-events-none"></i>
                    </div>
                    <!-- 직접 입력 모드 (기본 숨김) -->
                    <input type="text" id="name-A" class="team-name-input text-theme-red text-5xl md:text-6xl font-black uppercase tracking-widest hidden h-full" value="1반" oninput="syncCustomName('A')" spellcheck="false">
                    <button id="cancel-custom-A" onclick="revertToSelect('A')" class="hidden absolute -right-2 top-1/2 -translate-y-1/2 w-8 h-8 md:w-10 md:h-10 bg-gray-600 hover:bg-red-500 rounded-full text-white font-bold flex justify-center items-center transition shadow-lg z-10"><i class="fas fa-times"></i></button>
                </div>

                <div class="bg-gray-900/60 rounded-2xl w-full p-3 md:p-4 flex justify-between items-center border border-gray-700/50 mb-4 shadow-inner">
                    <span class="set-score-text text-gray-400 font-bold text-lg md:text-xl tracking-widest pl-2">SET SCORE</span>
                    <div class="flex items-center justify-end pr-2 md:pr-4 flex-1">
                        <span id="set-score-A" class="set-score-val text-5xl md:text-6xl font-black text-white text-center tabular-nums drop-shadow-[0_0_10px_rgba(255,255,255,0.3)]">0</span>
                    </div>
                </div>

                <div id="point-A" class="rally-point text-[10rem] md:text-[16rem] font-black leading-none tabular-nums tracking-tighter mb-2">0</div>

                <table class="set-score-table">
                    <thead>
                        <tr><th>1 SET</th><th>2 SET</th><th>3 SET</th><th>4 SET</th><th>5 SET</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td id="history-A-1" class="active-set">-</td>
                            <td id="history-A-2">-</td>
                            <td id="history-A-3">-</td>
                            <td id="history-A-4">-</td>
                            <td id="history-A-5">-</td>
                        </tr>
                    </tbody>
                </table>

                <div class="point-btn-group flex gap-3 w-full mt-auto">
                    <button id="btn-minus-A" onclick="changePoint('A', -1)" class="flex-1 btn-minus-red py-4 md:py-6 rounded-2xl font-bold text-4xl md:text-5xl transition shadow-inner">-</button>
                    <button id="btn-plus-A" onclick="changePoint('A', 1)" class="flex-[2] btn-plus-red text-white py-4 md:py-6 rounded-2xl font-black text-6xl md:text-7xl transition shadow-lg">+</button>
                </div>
            </div>

            <div class="center-controls flex md:flex-col justify-center gap-2 md:gap-4 w-full md:w-32 shrink-0 order-2 z-10 flex-wrap md:flex-nowrap">
                <button onclick="toggleServe()" class="flex-1 md:flex-none bg-orange-600 hover:bg-orange-500 text-white font-black py-2 md:py-6 rounded-xl shadow-lg border-2 border-orange-400 transition text-xs md:text-lg flex flex-col items-center justify-center gap-1">
                    <i class="fas fa-volleyball"></i>
                    <span>서브 교대</span>
                </button>
                <button onclick="swapCourts()" class="flex-1 md:flex-none bg-indigo-600 hover:bg-indigo-500 text-white font-black py-2 md:py-6 rounded-xl shadow-lg border-2 border-indigo-400 transition text-xs md:text-lg flex flex-col items-center justify-center gap-1">
                    <i class="fas fa-sync-alt"></i>
                    <span>코트 교대</span>
                </button>
                <button onclick="resetPoints()" class="flex-1 md:flex-none bg-gray-700 hover:bg-gray-600 text-white font-bold py-2 md:py-6 rounded-xl border border-gray-500 transition text-xs md:text-base">
                    점수 초기화
                </button>
                <button onclick="showConfirmModal()" class="flex-1 md:flex-none bg-red-900/80 hover:bg-red-800 text-red-200 font-bold py-2 md:py-6 rounded-xl border border-red-700 transition text-xs md:text-base">
                    전체 초기화
                </button>
            </div>

            <div id="panel-B" class="glass-panel flex-1 rounded-3xl p-4 md:p-6 flex flex-col items-center border-t-8 theme-blue relative shadow-2xl transition-all duration-500 order-3">
                
                <div id="serve-badge-B" class="serve-badge absolute top-4 left-4 bg-yellow-500 text-black font-black px-3 py-2 rounded-xl shadow-lg border border-yellow-200 z-10 flex flex-col items-center gap-1">
                    <div class="flex items-center gap-1 text-xs md:text-sm">
                        <i class="fas fa-volleyball"></i> SERVE
                    </div>
                    <div class="flex items-center justify-center text-sm md:text-base font-bold bg-yellow-600/50 rounded-lg px-3 py-1 min-w-[4rem]">
                        <span id="server-num-B" class="text-center">1번</span>
                    </div>
                </div>

                <div class="flex gap-2 mb-2 justify-center w-full z-20">
                    <button onclick="setTheme('B', 'red')" class="w-5 h-5 rounded-full bg-red-500 border-2 border-transparent focus:border-white hover:scale-110 transition"></button>
                    <button onclick="setTheme('B', 'blue')" class="w-5 h-5 rounded-full bg-blue-500 border-2 border-transparent focus:border-white hover:scale-110 transition"></button>
                    <button onclick="setTheme('B', 'yellow')" class="w-5 h-5 rounded-full bg-yellow-500 border-2 border-transparent focus:border-white hover:scale-110 transition"></button>
                    <button onclick="setTheme('B', 'green')" class="w-5 h-5 rounded-full bg-green-500 border-2 border-transparent focus:border-white hover:scale-110 transition"></button>
                </div>

                <!-- 팀 이름 드롭다운 & 직접입력 -->
                <div class="name-wrapper w-full flex items-center justify-center relative mb-4 h-16 md:h-20">
                    <div class="relative w-full flex justify-center items-center h-full">
                        <select id="select-B" onchange="handleNameSelect('B')" class="team-name-input text-theme-blue text-5xl md:text-6xl font-black uppercase tracking-widest cursor-pointer appearance-none bg-transparent h-full">
                            <option value="1반" class="text-black text-2xl">1반</option>
                            <option value="2반" class="text-black text-2xl" selected>2반</option>
                            <option value="3반" class="text-black text-2xl">3반</option>
                            <option value="4반" class="text-black text-2xl">4반</option>
                            <option value="5반" class="text-black text-2xl">5반</option>
                            <option value="6반" class="text-black text-2xl">6반</option>
                            <option value="7반" class="text-black text-2xl">7반</option>
                            <option value="8반" class="text-black text-2xl">8반</option>
                            <option value="9반" class="text-black text-2xl">9반</option>
                            <option value="10반" class="text-black text-2xl">10반</option>
                            <option value="11반" class="text-black text-2xl">11반</option>
                            <option value="12반" class="text-black text-2xl">12반</option>
                            <option value="custom" class="text-black text-2xl font-bold bg-yellow-200">직접입력 ✏️</option>
                        </select>
                        <i id="icon-select-B" class="fas fa-chevron-down absolute right-4 text-2xl text-gray-400 pointer-events-none"></i>
                    </div>
                    <input type="text" id="name-B" class="team-name-input text-theme-blue text-5xl md:text-6xl font-black uppercase tracking-widest hidden h-full" value="2반" oninput="syncCustomName('B')" spellcheck="false">
                    <button id="cancel-custom-B" onclick="revertToSelect('B')" class="hidden absolute -right-2 top-1/2 -translate-y-1/2 w-8 h-8 md:w-10 md:h-10 bg-gray-600 hover:bg-red-500 rounded-full text-white font-bold flex justify-center items-center transition shadow-lg z-10"><i class="fas fa-times"></i></button>
                </div>

                <div class="bg-gray-900/60 rounded-2xl w-full p-3 md:p-4 flex justify-between items-center border border-gray-700/50 mb-4 shadow-inner">
                    <span class="set-score-text text-gray-400 font-bold text-lg md:text-xl tracking-widest pl-2">SET SCORE</span>
                    <div class="flex items-center justify-end pr-2 md:pr-4 flex-1">
                        <span id="set-score-B" class="set-score-val text-5xl md:text-6xl font-black text-white text-center tabular-nums drop-shadow-[0_0_10px_rgba(255,255,255,0.3)]">0</span>
                    </div>
                </div>

                <div id="point-B" class="rally-point text-[10rem] md:text-[16rem] font-black leading-none tabular-nums tracking-tighter mb-2">0</div>

                <table class="set-score-table">
                    <thead>
                        <tr><th>1 SET</th><th>2 SET</th><th>3 SET</th><th>4 SET</th><th>5 SET</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td id="history-B-1" class="active-set">-</td>
                            <td id="history-B-2">-</td>
                            <td id="history-B-3">-</td>
                            <td id="history-B-4">-</td>
                            <td id="history-B-5">-</td>
                        </tr>
                    </tbody>
                </table>

                <div class="point-btn-group flex gap-3 w-full mt-auto">
                    <button id="btn-minus-B" onclick="changePoint('B', -1)" class="flex-1 btn-minus-blue py-4 md:py-6 rounded-2xl font-bold text-4xl md:text-5xl transition shadow-inner">-</button>
                    <button id="btn-plus-B" onclick="changePoint('B', 1)" class="flex-[2] btn-plus-blue text-white py-4 md:py-6 rounded-2xl font-black text-6xl md:text-7xl transition shadow-lg">+</button>
                </div>
            </div>
        </div>
    </div>

    <div id="confirm-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4 backdrop-blur-sm">
        <div class="bg-gray-800 border border-gray-600 rounded-3xl p-6 md:p-8 max-w-sm w-full text-center shadow-2xl">
            <div class="text-2xl font-black text-red-500 mb-2">⚠️ 경고</div>
            <div class="text-lg text-white mb-8">모든 세트 스코어와 점수를<br>0으로 초기화하시겠습니까?</div>
            <div class="flex gap-4">
                <button onclick="closeConfirmModal()" class="flex-1 bg-gray-600 hover:bg-gray-500 text-white py-3 rounded-xl font-bold transition">취소</button>
                <button onclick="resetAll()" class="flex-1 bg-red-600 hover:bg-red-500 text-white py-3 rounded-xl font-black transition shadow-lg">확인</button>
            </div>
        </div>
    </div>

    <script>
        // State variables
        let currentSet = 1;
        let highestSetReached = 1; 
        let setScores = { A: 0, B: 0 };
        let points = { A: 0, B: 0 };
        let currentServe = 'A'; 
        let currentServer = { A: 1, B: 1 }; 
        let hasServedThisSet = { A: true, B: false }; 
        let themes = { A: 'red', B: 'blue' };
        let isSwapped = false; 
        
        let scoreHistory = {
            1: { A: null, B: null },
            2: { A: null, B: null },
            3: { A: null, B: null },
            4: { A: null, B: null },
            5: { A: null, B: null }
        };

        const THEME_CLASSES = ['red', 'blue', 'yellow', 'green'];

        window.onload = () => {
            updateUI();
        };

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {
                    console.log(`Error attempting to enable full-screen mode: ${err.message}`);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        function changeSet(amount) {
            saveCurrentSetScore();
            
            currentSet += amount;
            if (currentSet < 1) currentSet = 1;
            if (currentSet > 5) currentSet = 5; 
            
            if (currentSet > highestSetReached) {
                highestSetReached = currentSet;
            }

            document.getElementById('set-display').innerText = `${currentSet} SET`;
            
            // 세트 변경 시 서브 1번으로 자동 리셋
            currentServer.A = 1;
            currentServer.B = 1;
            hasServedThisSet = { A: currentServe === 'A', B: currentServe === 'B' };
            
            loadSetScore();
            updateHistoryUI();
            updateUI();
        }
        
        function saveCurrentSetScore() {
            scoreHistory[currentSet].A = points.A;
            scoreHistory[currentSet].B = points.B;
        }

        function loadSetScore() {
            points.A = scoreHistory[currentSet].A !== null ? scoreHistory[currentSet].A : 0;
            points.B = scoreHistory[currentSet].B !== null ? scoreHistory[currentSet].B : 0;
        }

        // 세트 스코어 자동 계산 로직
        function calculateSetScores() {
            let winsA = 0;
            let winsB = 0;

            for (let i = 1; i <= 5; i++) {
                let pA = scoreHistory[i].A;
                let pB = scoreHistory[i].B;

                if (pA !== null && pB !== null) {
                    let winner = null;
                    const target = (i === 5) ? 15 : 25;

                    // 1. 배구 정규 룰
                    if (pA >= target && (pA - pB) >= 2) winner = 'A';
                    else if (pB >= target && (pB - pA) >= 2) winner = 'B';
                    
                    // 2. 변칙 룰 지원 (다음 세트로 넘어갔을 경우 무조건 높은 팀이 승리)
                    if (!winner && i < highestSetReached) {
                        if (pA > pB) winner = 'A';
                        else if (pB > pA) winner = 'B';
                    }

                    if (winner === 'A') winsA++;
                    else if (winner === 'B') winsB++;
                }
            }
            
            setScores.A = winsA;
            setScores.B = winsB;
        }

        function changePoint(team, amount) {
            points[team] = Math.max(0, points[team] + amount);
            scoreHistory[currentSet][team] = points[team];
            
            if (amount > 0) {
                if (currentServe !== team) {
                    currentServe = team;
                    if (!hasServedThisSet[team]) {
                        hasServedThisSet[team] = true;
                    } else {
                        currentServer[team] = (currentServer[team] % 7) + 1;
                    }
                } else {
                    currentServer[team] = (currentServer[team] % 7) + 1;
                }
            }
            
            updateHistoryUI();
            updateUI();
        }

        function resetPoints() {
            points.A = 0;
            points.B = 0;
            scoreHistory[currentSet].A = 0;
            scoreHistory[currentSet].B = 0;
            currentServer = { A: 1, B: 1 };
            hasServedThisSet = { A: currentServe === 'A', B: currentServe === 'B' };
            updateHistoryUI();
            updateUI();
        }

        function toggleServe() {
            currentServe = currentServe === 'A' ? 'B' : 'A';
            if (points.A === 0 && points.B === 0) {
                hasServedThisSet = { A: currentServe === 'A', B: currentServe === 'B' };
            }
            updateUI();
        }

        function swapCourts() {
            isSwapped = !isSwapped;
            const panelA = document.getElementById('panel-A');
            const panelB = document.getElementById('panel-B');
            
            if (isSwapped) {
                panelA.classList.remove('order-1');
                panelA.classList.add('order-3');
                
                panelB.classList.remove('order-3');
                panelB.classList.add('order-1');
            } else {
                panelA.classList.remove('order-3');
                panelA.classList.add('order-1');
                
                panelB.classList.remove('order-1');
                panelB.classList.add('order-3');
            }
        }

        // 테마 색상 및 팀명 변경 로직
        function setTheme(team, color) {
            const panel = document.getElementById(`panel-${team}`);
            const select = document.getElementById(`select-${team}`);
            const nameInput = document.getElementById(`name-${team}`);
            const btnMinus = document.getElementById(`btn-minus-${team}`);
            const btnPlus = document.getElementById(`btn-plus-${team}`);

            THEME_CLASSES.forEach(c => {
                panel.classList.remove(`theme-${c}`);
                if(select) select.classList.remove(`text-theme-${c}`);
                nameInput.classList.remove(`text-theme-${c}`);
                btnMinus.classList.remove(`btn-minus-${c}`);
                btnPlus.classList.remove(`btn-plus-${c}`);
            });

            themes[team] = color;
            panel.classList.add(`theme-${color}`);
            if(select) select.classList.add(`text-theme-${color}`);
            nameInput.classList.add(`text-theme-${color}`);
            btnMinus.classList.add(`btn-minus-${color}`);
            btnPlus.classList.add(`btn-plus-${color}`);
        }

        function handleNameSelect(team) {
            const select = document.getElementById(`select-${team}`);
            const input = document.getElementById(`name-${team}`);
            const icon = document.getElementById(`icon-select-${team}`);
            const cancelBtn = document.getElementById(`cancel-custom-${team}`);
            
            if (select.value === 'custom') {
                select.classList.add('hidden');
                icon.classList.add('hidden');
                
                input.classList.remove('hidden');
                cancelBtn.classList.remove('hidden');
                input.value = ''; 
                input.focus();
            } else {
                input.value = select.value;
            }
        }
        
        function syncCustomName(team) {
            const input = document.getElementById(`name-${team}`);
            // 필요에 따라 빈칸 처리 가능
        }

        function revertToSelect(team) {
            const select = document.getElementById(`select-${team}`);
            const input = document.getElementById(`name-${team}`);
            const icon = document.getElementById(`icon-select-${team}`);
            const cancelBtn = document.getElementById(`cancel-custom-${team}`);
            
            input.classList.add('hidden');
            cancelBtn.classList.add('hidden');
            
            select.classList.remove('hidden');
            icon.classList.remove('hidden');
            
            select.value = (team === 'A') ? '1반' : '2반'; 
            input.value = select.value;
        }

        function showConfirmModal() {
            document.getElementById('confirm-modal').classList.remove('hidden');
        }
        
        function closeConfirmModal() {
            document.getElementById('confirm-modal').classList.add('hidden');
        }

        function resetAll() {
            currentSet = 1;
            highestSetReached = 1;
            setScores = { A: 0, B: 0 };
            points = { A: 0, B: 0 };
            currentServe = 'A';
            currentServer = { A: 1, B: 1 };
            hasServedThisSet = { A: true, B: false };
            
            if (isSwapped) swapCourts();
            
            scoreHistory = {
                1: { A: null, B: null },
                2: { A: null, B: null },
                3: { A: null, B: null },
                4: { A: null, B: null },
                5: { A: null, B: null }
            };
            
            document.getElementById('set-display').innerText = `1 SET`;
            document.getElementById('set-score-A').innerText = '0';
            document.getElementById('set-score-B').innerText = '0';
            
            updateHistoryUI();
            updateUI();
            closeConfirmModal();
        }
        
        function updateHistoryUI() {
            ['A', 'B'].forEach(team => {
                for (let i = 1; i <= 5; i++) {
                    const cell = document.getElementById(`history-${team}-${i}`);
                    if (scoreHistory[i][team] !== null) {
                        cell.innerText = scoreHistory[i][team];
                    } else {
                        cell.innerText = '-';
                    }
                    
                    if (i === currentSet) {
                        cell.classList.add('active-set');
                    } else {
                        cell.classList.remove('active-set');
                    }
                }
            });
        }

        function updateUI() {
            calculateSetScores();
            document.getElementById('set-score-A').innerText = setScores.A;
            document.getElementById('set-score-B').innerText = setScores.B;

            document.getElementById('point-A').innerText = points.A;
            document.getElementById('point-B').innerText = points.B;

            document.getElementById('server-num-A').innerText = currentServer.A + '번';
            document.getElementById('server-num-B').innerText = currentServer.B + '번';

            const badgeA = document.getElementById('serve-badge-A');
            const badgeB = document.getElementById('serve-badge-B');
            
            if (currentServe === 'A') {
                badgeA.classList.add('serve-active');
                badgeB.classList.remove('serve-active');
            } else {
                badgeA.classList.remove('serve-active');
                badgeB.classList.add('serve-active');
            }
        }
    </script>
</body>
</html>
