<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Volleyball Scoreboard Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a; 
            color: white;
            user-select: none;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* 다이내믹 팀 색상 스타일 */
        .theme-red { border-top-color: #ef4444; }
        .theme-blue { border-top-color: #3b82f6; }
        .theme-yellow { border-top-color: #eab308; }
        .theme-green { border-top-color: #22c55e; }

        .text-theme-red { color: #f87171; }
        .text-theme-blue { color: #60a5fa; }
        .text-theme-yellow { color: #facc15; }
        .text-theme-green { color: #4ade80; }

        .btn-plus-red { background-color: #dc2626; } .btn-plus-red:hover { background-color: #ef4444; }
        .btn-plus-blue { background-color: #2563eb; } .btn-plus-blue:hover { background-color: #3b82f6; }
        .btn-plus-yellow { background-color: #ca8a04; color: black !important; } .btn-plus-yellow:hover { background-color: #eab308; }
        .btn-plus-green { background-color: #16a34a; } .btn-plus-green:hover { background-color: #22c55e; }

        .btn-minus-red { background-color: rgba(127, 29, 29, 0.5); color: #fca5a5; } .btn-minus-red:hover { background-color: rgba(153, 27, 27, 0.8); }
        .btn-minus-blue { background-color: rgba(30, 58, 138, 0.5); color: #93c5fd; } .btn-minus-blue:hover { background-color: rgba(30, 64, 175, 0.8); }
        .btn-minus-yellow { background-color: rgba(113, 63, 18, 0.5); color: #fef08a; } .btn-minus-yellow:hover { background-color: rgba(133, 77, 14, 0.8); }
        .btn-minus-green { background-color: rgba(20, 83, 45, 0.5); color: #86efac; } .btn-minus-green:hover { background-color: rgba(22, 101, 52, 0.8); }

        .serve-badge {
            opacity: 0;
            transform: scale(0.8);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .serve-active {
            opacity: 1;
            transform: scale(1);
            animation: pulse-glow 2s infinite;
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 10px rgba(234, 179, 8, 0.5); }
            50% { box-shadow: 0 0 25px rgba(234, 179, 8, 1); }
        }

        .tabular-nums { font-variant-numeric: tabular-nums; }
        
        .team-name-input {
            width: 100%;
            background: transparent;
            text-align: center;
            text-align-last: center; /* select 태그 텍스트 중앙 정렬 */
            outline: none;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s;
            padding-bottom: 4px;
        }
        .team-name-input:focus { border-bottom: 2px solid rgba(255,255,255,0.3); }
        select.team-name-input { padding-right: 0; }

        /* 세트별 점수판 테이블 스타일 */
        .set-score-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 4px;
            margin-top: auto;
            margin-bottom: 1rem;
        }
        .set-score-table th {
            color: #9ca3af;
            font-size: 0.875rem;
            font-weight: 700;
            padding-bottom: 4px;
        }
        .set-score-table td {
            background-color: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            padding: 8px;
            text-align: center;
            font-size: 1.25rem;
            font-weight: 900;
            color: white;
            width: 20%;
        }
        .set-score-table td.active-set {
            background-color: rgba(234, 179, 8, 0.2);
            border-color: rgba(234, 179, 8, 0.5);
            color: #facc15;
        }

        :fullscreen body {
            padding: 0 !important;
            margin: 0 !important;
            justify-content: center;
            overflow: hidden; 
        }
        :fullscreen #main-container {
            height: 100vh;
            width: 100vw;
            max-width: 100% !important; 
            padding: 2vh 2vw;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 2vh;
            margin: 0;
        }
        :fullscreen .top-controls { margin-bottom: 1vh !important; }
        :fullscreen #set-display { font-size: 14vh !important; } 
        :fullscreen .top-controls button { width: 12vh !important; height: 12vh !important; font-size: 6vh !important; }
        
        :fullscreen .team-name-input { font-size: 11vh !important; margin-bottom: 0 !important; }
        :fullscreen .name-wrapper { margin-bottom: 2vh !important; height: 12vh !important; }
        
        :fullscreen .bg-gray-900\/60 { padding: 2vh 3vw !important; } 
        :fullscreen .set-score-text { font-size: 4vh !important; }
        :fullscreen .set-score-val { font-size: 14vh !important; } 
        
        :fullscreen .rally-point { font-size: 52vh !important; line-height: 0.8 !important; margin: auto 0 !important; } 
        
        :fullscreen .point-btn-group button { padding-top: 5vh !important; padding-bottom: 5vh !important; font-size: 9vh !important; }
        
        :fullscreen .center-controls { flex-direction: column !important; justify-content: space-evenly; width: 12vw !important; gap: 2vh; }
        :fullscreen .center-controls button { padding: 3vh 1vw !important; font-size: 3.5vh !important; height: 100%; margin: 0; gap: 1.5vh; }
        :fullscreen .center-controls button i { font-size: 5vh !important; }
        
        :fullscreen .serve-badge { font-size: 3.5vh !important; padding: 2vh 3vw !important; top: 4vh; right: 4vh; transform: scale(1.4); transform-origin: top right; }
        
        :fullscreen .set-score-table { margin-bottom: 2vh !important; }
        :fullscreen .set-score-table td { font-size: 4.5vh !important; padding: 2vh !important; }
        :fullscreen .set-score-table th { font-size: 2.5vh !important; }
    </style>
</head>
<body class="p-4 relative">

    <div style="position: absolute; top: 15px; left: 15px; z-index: 1000;">
      <button onclick="toggleFullScreen()" class="bg-black/50 border border-white/30 text-white px-3 py-1.5 text-sm font-bold rounded-lg hover:bg-black/70 transition">
        <i class="fas fa-expand mr-1"></i> 전체화면
      </button>
    </div>

    <div id="main-container" class="w-full flex-1 flex flex-col items-center max-w-7xl mx-auto gap-4 mt-8 md:mt-4">
        
        <!-- 세트 표시 (상단) -->
